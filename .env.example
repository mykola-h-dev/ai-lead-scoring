# Copy to .env and fill in. Leave everything empty to run in demo mode
# (leads go to data/leads.csv, alerts are written to data/outbox.log).

# --- Google Sheet via Apps Script Web App (see apps_script/Code.gs) ---
SHEETS_WEBAPP_URL=
SHEETS_SHARED_SECRET=
CSV_PATH=data/leads.csv

# --- Slack: incoming webhook URL from https://api.slack.com/messaging/webhooks ---
SLACK_WEBHOOK_URL=

# --- Email alert via SMTP (STARTTLS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

HOST=127.0.0.1
PORT=8001

# --- AI lead scoring + auto-reply drafts (optional; leave empty for offline keyword rules) ---
# Keys are read from the environment only and never logged.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BUSINESS_NAME=Greenleaf Landscaping

# Auto-reply to the lead: off | draft (default: stored for review, never sent) | send (needs SMTP_* above)
AUTO_REPLY_MODE=draft
AUTO_REPLY_FROM=

# --- Spam protection ---
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=
# Optional extra throwaway-email domains, one per line
DISPOSABLE_DOMAINS_FILE=

# --- Dashboard (/dashboard). Set a password whenever the server is reachable from the network ---
DASHBOARD_PASSWORD=
# With a Google Sheet, also keep a local CSV copy so the dashboard has data (1/0)
LOCAL_COPY=1

# --- Optional HubSpot push (private-app token with crm.objects.contacts.write) ---
HUBSPOT_ACCESS_TOKEN=
