          "value": "#leads"
        },
        "text": "=:seedling: New lead: *{{ $('Validate lead').first().json.name }}* ({{ $('Validate lead').first().json.service }})\nEmail: {{ $('Validate lead').first().json.email }} | Phone: {{ $('Validate lead').first().json.phone || 'not given' }}\n{{ $('Validate lead').first().json.message }}",
        "otherOptions": {}
      },
      "name": "Slack alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
